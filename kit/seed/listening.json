    },
    {
      "stimulus_id": "LSN-A1-S3",
      "band": "A1",
      "topic_family": "course",
      "text": "A: Are you coming to the class tonight? B: Yes, but I may be a little late because my bus arrives at six forty. A: That is fine. The class starts at seven.",
      "item_ids": [
        "LSN-A1-05",
        "LSN-A1-06"
