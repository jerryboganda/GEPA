# GEPA v2 Environment Configuration
PORT=8080
SEED_DIR=seed

# Google Gemini API Models
GEMINI_API_KEY=
MODEL_RATER=gemini-2.5-flash
MODEL_FAST=gemini-2.5-flash
MODEL_TTS=gemini-2.5-flash

# Optional ElevenLabs TTS Adapter
