# GEPA v2 Environment Configuration
PORT=8080
SEED_DIR=seed

# Google Gemini API Models
# Placeholders pending a real `models.list` call (needs a live GEMINI_API_KEY,
# unavailable in the build environment) — see DECISIONS.md D-020. MODEL_RATER must
# be a Pro-class multimodal model (Speaking/Writing rating quality); MODEL_FAST /
# MODEL_TTS are cheaper Flash-class models for transcription/QC/TTS. Never pin all
# three to the same model.
GEMINI_API_KEY=
MODEL_RATER=gemini-2.5-pro
MODEL_FAST=gemini-2.5-flash
MODEL_TTS=gemini-2.5-flash

# Optional ElevenLabs TTS Adapter
ELEVENLABS_API_KEY=

# Postgres (DECISIONS.md D-021 — no Firebase). GitHub Actions provides a
# Postgres service container in CI; locally, point this at whatever Postgres
# instance you run yourself (nothing is started for you).
DATABASE_URL=postgres://gepa:gepa@localhost:5432/gepa

# Self-issued JWT signing secret (DECISIONS.md D-021 — server-issued tokens,
# no external identity provider). Generate a real random value for anything
# beyond local dev, e.g. `openssl rand -base64 32`.
JWT_SECRET=

# Security & Media
SIGNED_URL_TTL_SECONDS=600
E2E_MODE=false

# Feature Flags
FEATURE_PRETEST_ITEMS=false
FEATURE_AI_DETECTOR_FLAGS=false
FEATURE_PRODUCTIVE_EXTENSION=false
BETA_CONFIDENCE_CAP=Moderate
