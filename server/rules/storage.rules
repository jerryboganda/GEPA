rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Audio stimuli: only accessible via short-lived signed URLs generated by the server
    match /audio/stimuli/{allPaths=**} {
      allow read, write: if false;
    }

    // Audio responses: private; server-side rating read only
    match /audio/responses/{sessionId}/{taskId}/{attempt} {
      allow read, write: if false;
    }

    // Default deny all client access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
